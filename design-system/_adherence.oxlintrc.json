        "selector": "JSXOpeningElement[name.name='WorkListing'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<WorkListing> size must be one of 'sm' | 'md' | 'lg'."
      }
