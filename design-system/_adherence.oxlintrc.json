        "selector": "JSXOpeningElement[name.name='SocialIcons'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SocialIcons> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|note|color|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: value, label, note, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:tandoor|saffron|cilantro|subway|jacaranda|hibiscus|roosevelt)$/]",
        "message": "<StatTile> color must be one of 'tandoor' | 'saffron' | 'cilantro' | 'subway' | 'jacaranda' | 'hibiscus' | 'roosevelt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveformMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|showWord|color|style|key|ref|className|style|children)$/]",
        "message": "<WaveformMark> doesn't accept that prop. Declared props: height, showWord, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|color|align|height|base|alt|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: orientation, color, align, height, base, alt, style."
