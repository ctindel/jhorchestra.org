{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/media/**",
              "ui_kits/print_social/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|arrow|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, arrow, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|donate|secondary|ghostDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'donate' | 'secondary' | 'ghostDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|radius|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, radius, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:newsprint|ink|accent|raised)$/]",
        "message": "<Card> tone must be one of 'newsprint' | 'ink' | 'accent' | 'raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Card> radius must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|glyph|outline|muted|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, glyph, outline, muted, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tandoor|saffron|cilantro|subway|jacaranda|hibiscus|roosevelt)$/]",
        "message": "<Chip> tone must be one of 'tandoor' | 'saffron' | 'cilantro' | 'subway' | 'jacaranda' | 'hibiscus' | 'roosevelt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConcertMedia'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|glyph|tone|muted|key|ref|className|style|children)$/]",
        "message": "<ConcertMedia> doesn't accept that prop. Declared props: label, glyph, tone, muted."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConcertMedia'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tandoor|saffron|cilantro|subway|jacaranda|hibiscus|roosevelt)$/]",
        "message": "<ConcertMedia> tone must be one of 'tandoor' | 'saffron' | 'cilantro' | 'subway' | 'jacaranda' | 'hibiscus' | 'roosevelt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, size, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tandoor|saffron|subway|muted|ink|paper)$/]",
        "message": "<Eyebrow> tone must be one of 'tandoor' | 'saffron' | 'subway' | 'muted' | 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Eyebrow> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GriffinSeal'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|base|alt|style|key|ref|className|style|children)$/]",
        "message": "<GriffinSeal> doesn't accept that prop. Declared props: size, base, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|as|italic|color|children|style|key|ref|className|style|children)$/]",
        "message": "<Headline> doesn't accept that prop. Declared props: level, as, italic, color, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Headline'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:hero|display|h1|h2|h3|h4)$/]",
        "message": "<Headline> level must be one of 'hero' | 'display' | 'h1' | 'h2' | 'h3' | 'h4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|showWords|tone|style|key|ref|className|style|children)$/]",
        "message": "<Monogram> doesn't accept that prop. Declared props: color, size, showWords, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:subway|tandoor|cilantro|saffron|jacaranda|hibiscus|roosevelt)$/]",
        "message": "<Monogram> color must be one of 'subway' | 'tandoor' | 'cilantro' | 'saffron' | 'jacaranda' | 'hibiscus' | 'roosevelt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Monogram> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MosaicRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|gap|style|key|ref|className|style|children)$/]",
        "message": "<MosaicRule> doesn't accept that prop. Declared props: variant, height, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MosaicRule'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:rule|bar|grid)$/]",
        "message": "<MosaicRule> variant must be one of 'rule' | 'bar' | 'grid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Portrait'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|role|size|shape|layout|nameSize|roleSize|tone|style|key|ref|className|style|children)$/]",
        "message": "<Portrait> doesn't accept that prop. Declared props: src, name, role, size, shape, layout, nameSize, roleSize, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Portrait'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|round)$/]",
        "message": "<Portrait> shape must be one of 'square' | 'round'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Portrait'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:inline|stacked)$/]",
        "message": "<Portrait> layout must be one of 'inline' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Portrait'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Portrait> tone must be one of 'light' | 'dark'."
