      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:stacked|horizontal)$/]",
        "message": "<Wordmark> orientation must be one of 'stacked' | 'horizontal'."
