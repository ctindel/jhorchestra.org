        "message": "<Wordmark> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkListing'] > JSXAttribute > JSXIdentifier[name!=/^(?:composer|work|tag|number|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<WorkListing> doesn't accept that prop. Declared props: composer, work, tag, number, tone, size, style."
