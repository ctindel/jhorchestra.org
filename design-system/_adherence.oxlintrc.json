        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:subway|tandoor|cilantro|saffron|black|white)$/]",
        "message": "<Wordmark> color must be one of 'subway' | 'tandoor' | 'cilantro' | 'saffron' | 'black' | 'white'."
